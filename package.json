{
  "name": "kyoupoke-channel-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cf:typegen": "wrangler types",
    "cf:secret": "node --env-file=.env.local scripts/cloudflare-secret.mjs",
    "cf:dry-run": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy:cloudflare": "npm run check:quality && npm run deploy:vinext -- --skip-build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:quality": "node scripts/check-quality.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@gsap/react": "^2.1.2",
    "@notionhq/client": "^5.23.3",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "5.11.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "4.16.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "^8.0.0",
    "wrangler": "4.131.2"
  },
  "type": "module"
}
