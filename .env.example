# Notion連携（メンバー・コンテンツDBの取得）に使用
# https://www.notion.so/my-integrations で発行したInternal Integration Secretを設定し、
# Notion側の「kyoupoke」ページにこのインテグレーションを接続してください。
NOTION_TOKEN=

# 公開するファンサイト運営者の問い合わせ宛先。未設定時は窓口準備中。
CONTACT_EMAIL=

# 本番の統計更新（YouTube Data API v3 のみに制限したサーバー用キー）
YOUTUBE_API_KEY=
# Vercel Schedules と更新ルートの共有シークレット（Production）
CRON_SECRET=
# 任意：公式Xでの登録者数の節目を自動取得する場合に使用
X_BEARER_TOKEN=
